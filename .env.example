# MidLand Constructions — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3001

# Admin credentials (only used to create the FIRST admin account — after that,
# change the password from within the admin panel, not here)
ADMIN_USER=admin
ADMIN_PASS=midland2025

# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret

# ── Persistent database (required for production / Vercel) ──────────────────
# Without these, the app falls back to a local SQLite file, which is fine for
# local development but is WIPED on every Vercel deploy/restart. Get these for
# free at https://turso.tech (see README.md for setup steps):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
