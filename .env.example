# MidLand Constructions — environment variables
# Local: copy to .env (cp .env.example .env). Production: add each one in
# Vercel → Project → Settings → Environment Variables, then redeploy.

PORT=3001

# REQUIRED in production. 64 random hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used ONLY to create the first admin account when the database has none.
# Pick a strong password, then change it from Admin → Settings after first login.
ADMIN_USER=admin
ADMIN_PASS=

# Persistent database — REQUIRED on Vercel (free at https://turso.tech).
# Without these, data is stored in a local file that Vercel wipes on every deploy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public business details shown on the website (one place for the whole site)
SITE_URL=https://midland-pi.vercel.app
WHATSAPP_NUMBER=923001234567
CONTACT_PHONE=+92 300 1234567
CONTACT_EMAIL=info@midlandpk.com
CONTACT_ADDRESS=DHA Phase 6, Lahore
